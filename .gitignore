# ============================================================
# ENVIRONMENT VARIABLES AND SECRETS
# ============================================================

.env
.env.local
.env.development
.env.production
.env.test
*.env.local

# Keep the safe environment-variable template
!.env.example


# ============================================================
# AZURE CREDENTIALS
# ============================================================

.azure/


# ============================================================
# API KEYS AND CREDENTIAL FILES
# ============================================================

credentials.json
secrets.json
service-account.json


# ============================================================
# PYTHON CACHE AND COMPILED FILES
# ============================================================

__pycache__/
**/__pycache__/
*.py[cod]
*$py.class


# ============================================================
# PYTHON VIRTUAL ENVIRONMENTS
# ============================================================

.venv/
venv/
env/
ENV/


# ============================================================
# TESTING, LINTING, AND COVERAGE FILES
# ============================================================

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/


# ============================================================
# MACHINE-LEARNING MODEL ARTIFACTS
# ============================================================

*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx

# Keep the approved model artifacts required by the backend
!models/xgb_model.joblib
!models/preprocessor.joblib


# ============================================================
# VECTOR DATABASES
# ============================================================

# Ignore root-level vector stores, but keep the approved RAG store
/vector_store/
chroma_db/
backend/chroma_db/

# Keep the approved persisted RAG store required by the backend.
!rag/vector_store/chroma.sqlite3
!rag/vector_store/**/
!rag/vector_store/**/*.bin


# ============================================================
# RAW AND PROCESSED PROJECT DATA
# ============================================================

data/raw/*
data/processed/*

# Retain folder placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep the approved Shipment Tool dataset
!data/processed/shipment_tool_data.csv

# Keep the synthetic Inventory Tool dataset
!data/processed/inventory_tool_data.csv

# Keep the existing processed project datasets
!data/processed/df_model.zip
!data/processed/df_clean.zip


# ============================================================
# JUPYTER NOTEBOOK FILES
# ============================================================

.ipynb_checkpoints/
**/.ipynb_checkpoints/


# ============================================================
# FRONTEND DEPENDENCIES AND BUILD OUTPUTS
# ============================================================

frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.cache/


# ============================================================
# BACKEND TEMPORARY FILES
# ============================================================

*.log
logs/
backend/logs/
backend/tmp/
backend/temp/


# ============================================================
# OPERATING-SYSTEM FILES
# ============================================================

.DS_Store
Thumbs.db

